  "dialogue": {
    "u000": {
      "speaker": "yametaro",
      "text": "最近、AIで作った3Dモデルの投稿、よう見るなあ。画像一枚から作りました、みたいなやつ。",
      "intent": "新しいAI制作例を興味深く眺める",
      "yametaro": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 45,
            "mood": "normal",
            "motion": "tilt",
            "durationInFrames": 36
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 140,
            "mood": "happy"
          }
        ]
      }
    },
    "u002": {
      "speaker": "yametaro",
      "text": "ワイもCodexに頼んでみたんや。そば屋さんを3Dにして、って。これや。",
      "intent": "自作を見せた瞬間に二人が気まずくなる",
      "yametaro": {
        "mood": "smug",
        "beats": [
          {
            "atFrame": 133,
            "mood": "worry"
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 135,
            "mood": "worry",
            "motion": "tilt",
            "durationInFrames": 24
          }
        ]
      }
    },
    "u004": {
      "speaker": "takosan",
      "text": "誰を作ろうとしたかは、伝わります。",
      "intent": "たこさんは言葉を選び、やめ太郎には微妙な褒め方が刺さる",
      "yametaro": {
        "mood": "worry",
        "beats": [
          {
            "atFrame": 64,
            "mood": "bored"
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "u005": {
      "speaker": "yametaro",
      "text": "その感想、いちばん困るやつや。",
      "intent": "困る感想への小さなツッコミ",
      "yametaro": {
        "mood": "worry",
        "beats": [
          {
            "atFrame": 5,
            "mood": "worry",
            "motion": "tilt",
            "durationInFrames": 30
          }
        ]
      },
      "takosan": {
        "mood": "worry",
        "beats": []
      }
    },
    "r006": {
      "speaker": "takosan",
      "text": "Tripoというサービスを使うと、ここまで作れます。",
      "intent": "新モデルを提示し、聞き手は実物を見て驚く",
      "yametaro": {
        "mood": "worry",
        "beats": [
          {
            "atFrame": 28,
            "mood": "surprise"
          }
        ]
      },
      "takosan": {
        "mood": "smug",
        "beats": [
          {
            "atFrame": 6,
            "mood": "smug",
            "motion": "nod",
            "durationInFrames": 26
          }
        ]
      }
    },
    "u007": {
      "speaker": "yametaro",
      "text": "全然違うやん！　仮面も服も、ちゃんとそば屋さんや！",
      "intent": "最初の完成品への大きな反応は一度だけ跳ねる",
      "yametaro": {
        "mood": "surprise",
        "beats": [
          {
            "atFrame": 3,
            "mood": "surprise",
            "motion": "hop",
            "durationInFrames": 20
          }
        ]
      },
      "takosan": {
        "mood": "happy",
        "beats": []
      }
    },
    "u008": {
      "speaker": "takosan",
      "text": "これはTripoで原型を作って、生成後に手直ししたモデルです。",
      "intent": "喜びを保ちつつ、手直し済みという条件も伝える",
      "yametaro": {
        "mood": "happy",
        "beats": [
          {
            "atFrame": 112,
            "mood": "normal"
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "r009": {
      "speaker": "yametaro",
      "text": "しかも動いとる！　これ、動画を貼ってるんやなくて？",
      "intent": "動いているモデルへ身を乗り出す",
      "yametaro": {
        "mood": "surprise",
        "beats": [
          {
            "atFrame": 2,
            "mood": "surprise",
            "motion": "recoil",
            "durationInFrames": 24
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 58,
            "mood": "happy"
          }
        ]
      }
    },
    "r010": {
      "speaker": "takosan",
      "text": "はい。今ここで3Dを描画しています。この一体を、あとでサイトやゲームにも持っていきます。",
      "intent": "同じ一体を使い回せると分かって納得する",
      "yametaro": {
        "mood": "surprise",
        "beats": [
          {
            "atFrame": 70,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 28
          }
        ]
      },
      "takosan": {
        "mood": "smug",
        "beats": [
          {
            "atFrame": 171,
            "mood": "happy"
          }
        ]
      }
    },
    "u020": {
      "speaker": "yametaro",
      "text": "どうも、やめ太郎やで。",
      "intent": "視聴者への挨拶",
      "yametaro": {
        "mood": "happy",
        "beats": [
          {
            "atFrame": 7,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 30
          }
        ]
      },
      "takosan": {
        "mood": "happy",
        "beats": []
      }
    },
    "r021": {
      "speaker": "takosan",
      "text": "たこさんです。そば屋さんと私の実物で、画像から動く3Dまで見せます。",
      "intent": "たこさんの自己紹介と実物への案内",
      "yametaro": {
        "mood": "happy",
        "beats": [
          {
            "atFrame": 110,
            "mood": "normal"
          }
        ]
      },
      "takosan": {
        "mood": "happy",
        "beats": [
          {
            "atFrame": 4,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 30
          }
        ]
      }
    },
    "u022": {
      "speaker": "yametaro",
      "text": "本人が、自分の作り方を説明するんか。",
      "intent": "本人が自分を解説することへの軽いツッコミ",
      "yametaro": {
        "mood": "bored",
        "beats": [
          {
            "atFrame": 10,
            "mood": "bored",
            "motion": "tilt",
            "durationInFrames": 30
          }
        ]
      },
      "takosan": {
        "mood": "happy",
        "beats": [
          {
            "atFrame": 32,
            "mood": "smug"
          }
        ]
      }
    },
    "r023": {
      "speaker": "takosan",
      "text": "流れは四つ。姿を決める。Tripoで立体にする。本人らしく直す。そして、動かして使います。",
      "intent": "工程の全体像を落ち着いて示す",
      "yametaro": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 251,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 26
          }
        ]
      },
      "takosan": {
        "mood": "smug",
        "beats": []
      }
    },
    "u036": {
      "speaker": "yametaro",
      "text": "ほな、まず何を用意するん？",
      "intent": "最初に用意する物への素直な質問",
      "yametaro": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 8,
            "mood": "normal",
            "motion": "tilt",
            "durationInFrames": 32
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "u037": {
      "speaker": "takosan",
      "text": "基準になるキャラクターシートです。顔、体格、服、後ろ姿など、どんなキャラクターを作るのかを決めます。",
      "intent": "基準シートを示し、聞き手は後半で納得する",
      "yametaro": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 230,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 26
          }
        ]
      },
      "takosan": {
        "mood": "smug",
        "beats": []
      }
    },
    "s038": {
      "intent": "設計図という比喩をやめ太郎が自分の言葉で提示し、たこさんが理解を認める",
      "yametaro": {
        "mood": "smug",
        "beats": []
      },
      "takosan": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 72,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 28
          }
        ]
      },
      "speaker": "yametaro",
      "text": "いきなり立体を作る前に、まずは設計図をそろえるんやな。"
    },
    "u039": {
      "speaker": "takosan",
      "text": "はい。そして今回のそば屋さんでは、この姿をもとに、ぐるっと回転する動画を作りました。",
      "intent": "3Dの前に回転動画を作る手順が意外",
      "yametaro": {
        "mood": "normal",
        "beats": [
          {
            "atFrame": 160,
            "mood": "surprise"
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "u040": {
      "speaker": "yametaro",
      "text": "3Dを作りたいのに、先に動画を作るんか。",
      "intent": "工程の順番への疑問",
      "yametaro": {
        "mood": "worry",
        "beats": [
          {
            "atFrame": 6,
            "mood": "worry",
            "motion": "tilt",
            "durationInFrames": 34
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "r041": {
      "speaker": "takosan",
      "text": "同じ姿の、正面、横、後ろをそろえるためです。",
      "intent": "三方向をそろえる目的が分かる",
      "yametaro": {
        "mood": "worry",
        "beats": [
          {
            "atFrame": 120,
            "mood": "happy",
            "motion": "nod",
            "durationInFrames": 28
          }
        ]
      },
      "takosan": {
        "mood": "smug",
        "beats": []
      }
    },
    "u042": {
      "speaker": "yametaro",
      "text": "画像生成で、次は横向き、次は後ろ向き、って頼んだら、あかんの？",
      "intent": "簡単そうな代案を思いつく",
      "yametaro": {
        "mood": "smug",
        "beats": [
          {
            "atFrame": 4,
            "mood": "smug",
            "motion": "tilt",
            "durationInFrames": 30
          }
        ]
      },
      "takosan": {
        "mood": "normal",
        "beats": []
      }
    },
    "u043": {
      "speaker": "takosan",
