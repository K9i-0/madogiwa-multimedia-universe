  {
    "id": "line-092",
    "scene": "weapon",
    "view": "distribution",
    "who": "metan",
    "text": "すべてを実弾にする必要はないでしょう。",
    "pause": 9
  },
  {
    "id": "line-093",
    "scene": "weapon",
    "view": "distribution",
    "who": "zunda",
    "text": "おでんを軍事用語で説明するな。",
