{
  "name": "madogiwa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --pretty false",
    "check": "tsc -b --pretty false && tsc -p test/tsconfig.json --pretty false && eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "upload:video": "node tools/upload-video.mjs",
    "deploy:dry": "npm run cf-types && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run cf-types && npm run build && wrangler deploy",
    "cf-types": "wrangler types",
    "cf-types:check": "wrangler types",
    "check:startup": "wrangler check startup --outfile /tmp/madogiwa-studio-worker-startup.cpuprofile",
    "verify": "npm run cf-types:check && npm run check && npm test && npm run build && npm run check:startup && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply madogiwa-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply madogiwa-studio --remote",
    "dev:design": "vite --config design-preview/vite.config.ts",
    "check:design": "tsc -p design-preview/tsconfig.json",
    "build:design": "vite build --config design-preview/vite.config.ts",
    "prepare:design": "node tools/prepare-design.mjs",
    "build:ar": "tsc -p ar-preview/tsconfig.json && vite build --config ar-preview/vite.config.ts && node ar-preview/copy-assets.mjs",
    "preview:ar": "vite preview --config ar-preview/vite.config.ts --port 5175",
    "prepare:clips": "node tools/prepare-clips.mjs",
    "dev:clips": "npm run prepare:clips && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "agents": "^0.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
