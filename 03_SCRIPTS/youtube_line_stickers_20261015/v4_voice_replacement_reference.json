  "dialogue": [
    {
      "id": "intro-01",
      "who": "yametaro",
      "text": "窓際族のスタンプ、よう出来てるけど、使いどころ難しくない？",
      "view": "opening-grid",
      "chapter": 0,
      "audioSha256": "11f686d328d54f40aa12fb97546752d7281a405ea9aaec0c33069aa27a33b7a1",
      "gapBeforeFrames": 60,
      "captionTextPages": [
        "窓際族のスタンプ、よう出来てるけど、\n使いどころ難しくない？"
      ]
    },
    {
      "id": "intro-02",
      "who": "takosan",
      "text": "「ごめんやで」とか、使いやすそうですよ。",
      "view": "opening-grid",
      "chapter": 0,
      "audioSha256": "b787a78785fc383d99aae566b609e2a9fac8737a9127c3bbebe9bb0071815da7",
      "gapBeforeFrames": 9,
      "captionTextPages": [
        "「ごめんやで」とか、使いやすそうですよ。"
      ]
    },
    {
      "id": "intro-03",
      "who": "yametaro",
      "text": "ワイだけ使用頻度が高そうやな。でも、この「お前島流し！」は、いつ使うねん。",
      "view": "opening-grid",
      "chapter": 0,
      "audioSha256": "91f915c7472e665e53b057a93c6618d9c9e0edf2cae04a1fa2fd8b8f0df4884d",
      "gapBeforeFrames": 9,
      "captionTextPages": [
        "ワイだけ使用頻度が高そうやな。\nでも、この「お前島流し！」は、いつ使うねん。"
      ]
    },
    {
      "id": "intro-04",
      "who": "yametaro",
      "text": "よーたんからや。",
      "view": "line-chat",
