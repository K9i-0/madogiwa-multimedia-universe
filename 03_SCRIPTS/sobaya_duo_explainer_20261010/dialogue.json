    "text": "そして、そのベランダに立ち飲み処を開きました。",
    "mood": "normal",
    "scene": "bar",
    "audio": "line13_takosan.wav",
    "seed": 43,
    "durationScale": "1",
    "model": "Aratako/Irodori-TTS-v4.1-Small",
