  },
  {
    "who": "takosan",
    "text": "ところが、お店はベランダごと落下してしまいます。",
    "mood": "sad",
    "scene": "fall",
    "audio": "line15_takosan.wav",
    "seed": 43,
    "durationScale": "1",
    "model": "Aratako/Irodori-TTS-v4.1-Small",
    "caption": "",
    "textCfg": 5,
    "uncut": true,
    "reference": "02_CHARACTERS/Takosan_voice.wav",
    "reading": "ところが、おみせは、ベランダごと、らっかしてしまいます。"
  },
  {
    "who": "yametaro",
    "text": "せっかくの店が。これは、さすがに落ち込むわ。",
    "mood": "sad",
    "scene": "fall",
    "audio": "line16_yametaro.wav",
    "seed": 7,
    "durationScale": "0.70",
    "model": "Aratako/Irodori-TTS-v4.1-Small",
    "caption": "",
