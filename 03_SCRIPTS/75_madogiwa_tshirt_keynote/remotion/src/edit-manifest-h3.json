      "shot": "ch07",
      "source_sha256": "36d498076b4e556584e92127ef80755686633358399b3f772b7f7b3dd72367c4"
    },
    {
      "id": "reveal",
      "speaker": "sobaya",
      "text": "私たちは、これを、窓際族Tシャツと呼びます。",
      "start": 1419,
      "end": 1509,
      "audio": "line_reveal_sobaya_large.wav",
      "pauseFrames": 125,
      "shot": "ch08",
