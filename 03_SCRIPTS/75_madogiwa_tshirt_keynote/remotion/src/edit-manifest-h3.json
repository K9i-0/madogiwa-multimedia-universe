  "lines": [
    {
      "id": "intro",
      "speaker": "sobaya",
      "text": "今日という日を、私はずっと待っていました。",
      "start": 12,
      "end": 89,
      "audio": "line_intro_sobaya_large.wav",
      "pauseFrames": 36,
      "shot": "ch01",
      "source_sha256": "1170a7b00be1660db505901f01f0130749cc6d51a1d0db7049a5c5b007b8ab49"
    },
    {
      "id": "revolution",
      "speaker": "sobaya",
      "text": "時として、すべてを変えてしまう革命的な製品が現れます。",
      "start": 125,
      "end": 230,
      "audio": "line_revolution_sobaya_large.wav",
      "pauseFrames": 18,
      "shot": "ch01",
      "source_sha256": "60dccaf7c7752ef4dd1affb27a8da55dcdd1eacde91dcb07e28ff1e22733d5b4"
    },
    {
      "id": "lucky",
      "speaker": "sobaya",
      "text": "そんな製品を、ひとつでも紹介できれば幸運です。",
      "start": 248,
      "end": 336,
      "audio": "line_lucky_sobaya_large.wav",
      "pauseFrames": 24,
      "shot": "ch01",
      "source_sha256": "7775f848a84888d0b2865769ce6986a96eb9b6d498acdd591122e8dcd5351174"
    },
    {
      "id": "three",
      "speaker": "sobaya",
      "text": "今日、私たちは、3つ、紹介します。",
      "start": 370,
      "end": 438,
      "audio": "line_three_sobaya_large.wav",
      "pauseFrames": 65,
      "shot": "ch02",
      "source_sha256": "df9270453dc16e185680f0bace3c3469740589fb12a55882fc0be86f4ff2d43d"
    },
    {
      "id": "first",
      "speaker": "sobaya",
      "text": "ひとつめ。窓際族。",
      "start": 508,
      "end": 565,
      "audio": "line_first_sobaya_large.wav",
      "pauseFrames": 62,
      "shot": "ch03",
      "source_sha256": "d6dd05cea1fb93a1448ad8dd294a441860c2cd26cc06ff12c235fbc50f5f7824"
    },
    {
      "id": "second",
      "speaker": "sobaya",
      "text": "ふたつめ。T。",
      "start": 639,
      "end": 686,
      "audio": "line_second_sobaya_large.wav",
      "pauseFrames": 65,
      "shot": "ch04",
      "source_sha256": "50f67b3b573ffe0400da996e4a1b592e6b6ee8bd54dc4054107f15c15ee63409"
    },
    {
      "id": "third",
      "speaker": "sobaya",
      "text": "そして、みっつめ。シャツ。",
      "start": 763,
      "end": 820,
      "audio": "line_third_sobaya_large.wav",
      "pauseFrames": 85,
      "shot": "ch05",
      "source_sha256": "7e11dec9507387e81093053812ec6df6a28ced84dc0b0e08b6693eab9b0a49bf"
    },
    {
      "id": "repeat1",
      "speaker": "sobaya",
      "text": "窓際族。T。シャツ。",
      "start": 919,
      "end": 988,
      "audio": "line_repeat1_sobaya_large.wav",
      "pauseFrames": 22,
