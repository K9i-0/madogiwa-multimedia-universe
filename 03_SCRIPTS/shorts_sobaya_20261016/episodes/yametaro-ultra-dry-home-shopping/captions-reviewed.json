    "text": "これはですね。"
  },
  {
    "startFrame": 1080,
    "endFrame": 1152,
    "speaker": "そば屋",
    "text": "そば屋肥料\nめっちゃでかくなーる\nTwoです。"
  },
  {
    "startFrame": 1164,
    "endFrame": 1217,
    "speaker": "そば屋",
    "text": "そば屋肥料\nめっちゃでかくなーるTwoを\n使うと"
  },
  {
    "startFrame": 1217,
    "endFrame": 1276,
    "speaker": "そば屋",
    "text": "どんな野菜でも\nビールになるんです"
  },
  {
    "startFrame": 1768,
    "endFrame": 1817,
