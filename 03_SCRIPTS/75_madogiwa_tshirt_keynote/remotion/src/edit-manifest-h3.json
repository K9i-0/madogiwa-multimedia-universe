    },
    {
      "id": "reinvent",
      "speaker": "sobaya",
      "text": "今日、私たちはTシャツを再発明します。",
      "start": 1634,
      "end": 1722,
      "audio": "line_reinvent_sobaya_large.wav",
      "pauseFrames": 35,
