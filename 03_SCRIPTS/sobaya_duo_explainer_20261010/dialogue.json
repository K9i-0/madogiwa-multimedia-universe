  },
  {
    "who": "yametaro",
    "text": "席を戻してもらうより先に、店を開いたんか。",
    "mood": "normal",
    "scene": "bar",
    "audio": "line14_yametaro.wav",
    "seed": 7,
    "durationScale": "0.70",
    "model": "Aratako/Irodori-TTS-v4.1-Small",
